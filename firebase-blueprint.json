{
  "entities": {
    "students": {
      "title": "Students",
      "description": "Student user profiles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "enrollments": {
      "title": "Cohort Enrollments",
      "description": "Paid student cohort enrollment records",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "cohortId": { "type": "string" },
        "program": { "type": "string" },
        "payment_status": { "type": "string" },
        "enrollment_status": { "type": "string" },
        "transaction_id": { "type": "string" },
        "payment_gateway": { "type": "string" },
        "purchased_at": { "type": "string" }
      },
      "required": ["uid", "payment_status", "enrollment_status"]
    }
  },
  "firestore": {
    "/students/{uid}": {
      "schema": "students",
      "description": "Student profile documents indexed by Auth UID"
    },
    "/enrollments/{uid}": {
      "schema": "enrollments",
      "description": "Student cohort enrollment records indexed by Auth UID"
    }
  }
}
