# Set these in Cloud Run Variables & Secrets.
NODE_ENV=production
APP_URL=https://YOUR-CLOUD-RUN-URL-OR-CUSTOM-DOMAIN

# Gemini
GEMINI_API_KEY=

# PayU (server-side only)
PAYU_ENV=production
PAYU_KEY=
PAYU_SALT=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support.codexiaindia@gmail.com
GMAIL_USER=
GMAIL_PASS=

# hosted = server-generated checkout + verification; payment_link = fixed u.payu.in redirects
PAYU_CHECKOUT_MODE=payment_link
