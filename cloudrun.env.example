# Cloud Run runtime settings
NODE_ENV=production
# Cloud Run supplies PORT automatically; do not hard-code it in the app.

# Required if using Gemini server-side features
GEMINI_API_KEY=

# Public URL of the deployed service, if your app needs absolute callback/download URLs
APP_URL=

# Optional email/SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support.codexiaindia@gmail.com
GMAIL_USER=
GMAIL_PASS=

# Optional payment configuration
PAYU_SALT=
PAYU_REDIRECT_URL=
VITE_PAYU_MERCHANT_KEY=
VITE_RAZORPAY_KEY_ID=
